{
  "functions": [
    {
      "source": "functions",
      "codebase": "engineline",
      "ignore": ["node_modules", ".git", "*.log", "*.local", "src/**/*.test.ts"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "site": "motorcycle-verification-engine-line",
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/submit-check",
        "function": { "functionId": "submitEngineCheck", "region": "asia-east1" }
      },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
