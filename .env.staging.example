# 測試機（staging）專案的 client 設定 — 跟正式機 (.env / .env.example) 完全獨立，
# 指向 .firebaserc 的 "staging" 專案別名。複製成 .env.staging 並填入實際值
# （用 `npx firebase apps:sdkconfig WEB <appId> --project <staging-project-id>` 取得）。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
