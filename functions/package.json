{
  "name": "motorcycle-verification-functions",
  "version": "1.0.0",
  "private": true,
  "description": "MotoVerify Trusted Backend - Gemini Vision/Audio inspection, OCR routing, IMU analysis",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test --loader ts-node/esm src/**/*.test.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^2.21.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.21.0": true,
    "@ffmpeg-installer/ffmpeg@1.1.0": true,
    "@ffprobe-installer/ffprobe@2.1.2": true
  }
}
