{
  "name": "motorcycle-verification-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "vue-tsc -b && vite build",
    "build:staging": "vue-tsc -b && vite build --mode staging",
    "preview": "vite preview",
    "capture:dev": "vite --config capture-app/vite.config.ts",
    "capture:build": "vue-tsc -p capture-app/tsconfig.json --noEmit && vite build --config capture-app/vite.config.ts",
    "capture:cert": "mkdir -p capture-app/.cert && openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj /CN=ride-capture-dev -keyout capture-app/.cert/key.pem -out capture-app/.cert/cert.pem",
    "capture:deploy": "npm run capture:build && firebase deploy --only hosting --config capture-app/firebase.json --project motorcycle-verification",
    "training:export": "node scripts/export-training-dataset.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test:e2e": "playwright test",
    "seed:test-users": "node scripts/seed-test-users.mjs",
    "seed:demo-data": "node scripts/seed-demo-data.mjs",
    "seed:mock-vehicles": "node scripts/seed-mock-vehicles.mjs",
    "seed:marketplace-mock": "node scripts/seed-marketplace-mock.mjs",
    "import:vehicle-models": "node scripts/import-vehicle-models-csv.mjs",
    "cleanup:database": "node scripts/cleanup-database.mjs",
    "devlog:build": "node scripts/build-dev-log.mjs",
    "devlog:sync": "node scripts/sync-devlog.mjs",
    "deploy:staging": "npm run build:staging && firebase deploy --project staging",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capawesome/capacitor-torch": "^8.0.2",
    "capacitor-voice-recorder": "^7.0.6",
    "firebase": "^12.18.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
