          <div class="wordlist">
            <span class="word">保證</span><span class="word">無事故</span><span class="word">鑑定</span>
            <span class="word">合格</span><span class="word">不合格</span><span class="word">判定</span>
            <span class="word">保固</span><span class="word">通過檢驗</span><span class="word">總評分</span>
            <span class="word ctx">認證</span>
          </div>
