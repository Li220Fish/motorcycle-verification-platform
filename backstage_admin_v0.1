<script>
(function(){
  "use strict";

  var TITLES = {
    overview:   ["營運總覽", "尚未連接資料來源"],
    users:      ["使用者名冊", "collection: users"],
    userdetail: ["使用者詳情", "collection: users / vehicles / listings"],
    behaviour:  ["行為與興趣", "需先埋事件並由 Cloud Functions 聚合"],
    garage:     ["車庫與履歷", "collection: vehicles"],
    verify:     ["檢驗任務", "collection: verifications"],
    reports:    ["檢驗報告", "collection: reports"],
    market:     ["交易市場", "collection: listings"],
    messages:   ["訊息與檢舉", "collection: conversations / reports"],
    discussion: ["討論中心", "collection: posts"],
    news:       ["車訊新知", "collection: news"],
    probe:      ["Probe 裝置", "collection: devices"],
    models:     ["車款主檔", "collection: models"],
    push:       ["推播與提醒", "對應 app 設定頁「通知」"],
    copy:       ["文案守則檢查", "提案功能五 責任邊界"],
    consent:    ["個資同意管理", "提案功能八・風險 R4"],
    demo:       ["環境旗標", "簡報前確認全數關閉"]
  };

  var navItems = Array.prototype.slice.call(document.querySelectorAll(".nav-item"));
  var titleEl = document.getElementById("pageTitle");
  var crumbEl = document.getElementById("pageCrumb");

  function show(page){
    if(!TITLES[page]) return;
    Array.prototype.forEach.call(document.querySelectorAll(".page"), function(s){
      s.hidden = (s.id !== "page-" + page);
    });
    navItems.forEach(function(b){
      if(b.dataset.page === page){ b.setAttribute("aria-current","page"); }
      else { b.removeAttribute("aria-current"); }
    });
    titleEl.textContent = TITLES[page][0];
    crumbEl.textContent = TITLES[page][1];
    window.scrollTo(0,0);
  }

  navItems.forEach(function(b){
    b.addEventListener("click", function(){ show(b.dataset.page); });
  });
  Array.prototype.forEach.call(document.querySelectorAll("[data-goto]"), function(el){
    el.addEventListener("click", function(){ show(el.dataset.goto); });
  });

  Array.prototype.forEach.call(document.querySelectorAll(".filters"), function(group){
    var chips = group.querySelectorAll(".chip");
    Array.prototype.forEach.call(chips, function(c){
      c.addEventListener("click", function(){
        Array.prototype.forEach.call(chips, function(x){ x.setAttribute("aria-pressed","false"); });
        c.setAttribute("aria-pressed","true");
      });
    });
  });

  Array.prototype.forEach.call(document.querySelectorAll(".tog"), function(t){
    t.addEventListener("click", function(){
      t.setAttribute("aria-pressed", t.getAttribute("aria-pressed") === "true" ? "false" : "true");
    });
  });

  /* ---- 文案守則檢查（規則，非示範資料，保留） ---- */
  var BANNED = [
    { w:"保證",     why:"構成品質擔保。平台不做鑑定、不做保證，改寫為「提供初步篩選」。" },
    { w:"無事故",   why:"平台無法核實事故史，這是斷言而非觀察。改寫為「未偵測到明顯碰撞痕跡」。" },
    { w:"鑑定",     why:"鑑定意味專業判斷與責任。平台輸出的是注意事項，不是鑑定結果。" },
    { w:"合格",     why:"暗示平台做了通過與否的判定。模型只輸出 attention，不輸出 verdict。" },
    { w:"不合格",   why:"同上，且負面判定的爭議風險更高。" },
    { w:"判定",     why:"判定是結論。改寫為「標記」或「提示」。" },
    { w:"保固",     why:"§8.2 明確不碰保固，避免理賠精算與責任。" },
    { w:"通過檢驗", why:"平台不取代監理站定檢，這個說法會造成混淆。" },
    { w:"總評分",   why:"總分等同對外給出綜合判定，與功能五「不顯示總分」牴觸。" }
  ];
  var CONDITION_NOUNS = ["車況","車輛","車子","這台","報告","狀態","引擎","里程"];

  var input = document.getElementById("copyInput");
  var out = document.getElementById("findings");

  function esc(s){
    return String(s).replace(/[&<>"]/g, function(c){
      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];
    });
  }

  function check(){
    var text = input.value, found = [];

    if(!text.trim()){ out.innerHTML = ""; return; }

    BANNED.forEach(function(item){
      if(text.indexOf(item.w) !== -1){
        found.push({ level:"block", word:item.w, why:item.why });
      }
    });

    var at = text.indexOf("認證");
    while(at !== -1){
      var after = text.slice(at + 2, at + 6);
      var hit = CONDITION_NOUNS.some(function(n){ return after.indexOf(n) !== -1; });
      if(hit){
        found.push({ level:"block", word:"認證" + after.slice(0,2),
          why:"「認證」用於車況等同宣稱平台為車況背書。用於身分（實名認證）才是允許的。" });
      } else {
        found.push({ level:"warn", word:"認證",
          why:"確認這裡指的是身分認證而非車況認證。用於身分沒有問題，用於車況必須改寫。" });
      }
      at = text.indexOf("認證", at + 2);
    }

    if(!found.length){
      out.innerHTML = '<div class="finding clear"><b>沒有命中禁用詞</b>'
        + '<span class="why">仍請確認語氣沒有暗示保證或判定。工具只查字詞，不查語意。</span></div>';
      return;
    }

    out.innerHTML = found.map(function(f){
      return '<div class="finding ' + f.level + '"><b>'
        + (f.level === "block" ? "不可使用：" : "需確認：")
        + esc(f.word) + '</b><span class="why">' + esc(f.why) + '</span></div>';
    }).join("");
  }

  input.addEventListener("input", check);
})();
</script>
</body>
</html>
