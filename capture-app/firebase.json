{
  "hosting": {
    "site": "motorcycle-verification-capture",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/capture/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "redirects": [{ "source": "/", "destination": "/capture/", "type": 302 }],
    "rewrites": [{ "source": "/capture/**", "destination": "/capture/index.html" }]
  }
}
